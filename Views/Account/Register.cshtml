@model StudentAccounting.Models.ViewModels.RegisterViewModel

<h2>Регистрация нового пользователя</h2>
<form asp-action="Register" method="post">
    <div asp-validation-summary="All"></div>
    <div><label asp-for="Email"></label><input asp-for="Email" /></div>
    <div><label asp-for="Password"></label><input asp-for="Password" /></div>
    <div><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" /></div>
    <div>
        <label asp-for="Role"></label>
        <select asp-for="Role" asp-items="@(new SelectList(new[] { "Manager", "Admin" }))"></select>
    </div>
    <button type="submit">Зарегистрироваться</button>
</form>