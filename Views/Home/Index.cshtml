@model IEnumerable<StudentAccounting.Models.Course>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-number">@ViewBag.StudentsCount</div>
            <div class="stat-label">Студентов</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-number">@ViewBag.CoursesCount</div>
            <div class="stat-label">Курсов</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-number">@ViewBag.AverageGrade</div>
            <div class="stat-label">Средний балл</div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h4><i class="fas fa-chalkboard-teacher"></i> Курсы и кураторы</h4>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Название курса</th>
                    <th>Куратор</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td>@course.Title</td>
                        <td>@course.CuratorName</td>
                        <td><a asp-action="CourseStudents" asp-route-id="@course.Id" class="btn btn-sm btn-outline-primary">Список студентов</a></td>
                        <td><a asp-action="CourseSubjects" asp-route-id="@course.Id" class="btn btn-sm btn-outline-secondary">Список предметов</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>