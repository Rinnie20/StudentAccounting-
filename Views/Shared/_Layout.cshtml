<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Учёт студентов</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="/"><i class="fas fa-graduation-cap"></i> StudentAccounting</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="/"><i class="fas fa-home"></i> Главная (курсы)</a></li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" href="/Admin/Students"><i class="fas fa-users"></i> Управление студентами</a></li>
                                <li class="nav-item"><a class="nav-link" href="/Admin/Courses"><i class="fas fa-book"></i> Управление курсами</a></li>
                                <li class="nav-item"><a class="nav-link" href="/Admin/Subjects"><i class="fas fa-chalkboard"></i> Управление предметами</a></li>
                            }
                            @if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item"><a class="nav-link" href="/Manager/SelectCourse"><i class="fas fa-star"></i> Управление оценками</a></li>
                            }
                            <li class="nav-item"><span class="navbar-text text-light"><i class="fas fa-user"></i> Привет, @User.Identity.Name!</span></li>
                            <li class="nav-item"><a class="nav-link" href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Выйти</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="/Account/Login"><i class="fas fa-sign-in-alt"></i> Вход</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Account/Register"><i class="fas fa-user-plus"></i> Регистрация</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="container mt-4">
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>