@model IEnumerable<StudentAccounting.Models.Subject>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-chalkboard"></i> Управление предметами</h2>
    <a asp-action="CreateSubject" class="btn btn-success btn-lg">
        <i class="fas fa-plus-circle"></i> Добавить предмет
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Название</th>
                <th>Курс</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.Course?.Title</td>
                    <td>
                        <a asp-action="EditSubject" asp-route-id="@s.Id" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i> Изменить</a>
                        <form asp-action="DeleteSubject" asp-route-id="@s.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить предмет?')"><i class="fas fa-trash-alt"></i> Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>