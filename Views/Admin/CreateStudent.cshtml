@model StudentAccounting.Models.Student
@{
    var courses = ViewBag.Courses as IEnumerable<StudentAccounting.Models.Course>;
}

<div class="card shadow">
    <div class="card-header bg-primary text-white">
        <h3><i class="fas fa-user-plus"></i> Добавление студента</h3>
    </div>
    <div class="card-body">
        <form asp-action="CreateStudent" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MiddleName" class="form-label"></label>
                <input asp-for="MiddleName" class="form-control" />
                <span asp-validation-for="MiddleName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" class="form-control" type="date" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CourseId" class="form-label"></label>
                <select asp-for="CourseId" class="form-select">
                    <option value="">-- Не выбран --</option>
                    @if (courses != null)
                    {
                        foreach (var c in courses)
                        {
                            <option value="@c.Id">@c.Title</option>
                        }
                    }
                </select>
                <span asp-validation-for="CourseId" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Сохранить</button>
                <a asp-action="Students" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Назад</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}