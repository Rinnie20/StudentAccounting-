@model IEnumerable<StudentAccounting.Models.Course>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-book"></i> Управление курсами</h2>
    <a asp-action="CreateCourse" class="btn btn-success btn-lg">
        <i class="fas fa-plus-circle"></i> Создать курс
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Название</th>
                <th>Куратор</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Title</td>
                    <td>@c.CuratorName</td>
                    <td>
                        <a asp-action="EditCourse" asp-route-id="@c.Id" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i> Изменить</a>
                        <form asp-action="DeleteCourse" asp-route-id="@c.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить курс?')"><i class="fas fa-trash-alt"></i> Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>